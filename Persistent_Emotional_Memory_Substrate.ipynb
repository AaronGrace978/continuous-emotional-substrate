   "source": [
    "class ContinuousSubstrate:\n",
    "    def __init__(self, tick_interval: float = 0.3, daydream_interval: float = 2.0):\n",
    "        self.tick_interval = tick_interval\n",
    "        self.daydream_interval = daydream_interval\n",
    "        self.affect = AffectiveState()\n",
    "        self.memories: Dict[str, MemoryEnclave] = {}\n",
    "        self.inbox = queue.Queue()\n",
    "        self.running = False\n",
    "        self.tick_count = 0\n",
    "        self.last_daydream = time.time()\n",
    "        self.last_tick_time = time.time()\n",
    "        self.thread = None\n",
    "\n",
    "    def store_memory(self, content: str, valence: float, arousal: float, tags=None):\n",
    "        m_id = f'm_{int(time.time()*1000)}_{len(self.memories)}'\n",
    "        m = MemoryEnclave(id=m_id, content=content, valence=valence, arousal=arousal, tags=tags or [])\n",
    "        self.memories[m_id] = m\n",
    "        return m\n",
    "\n",
    "    def inject_stimulus(self, content: str, valence_delta: float = 0.0, arousal_delta: float = 0.0):\n",
    "        self.inbox.put({'content': content, 'v_delta': valence_delta, 'a_delta': arousal_delta, 'time': time.time()})\n",
    "\n",
    "    def recall(self, query: str, top_k: int = 2):\n",
    "        q_words = set(query.lower().split())\n",
    "        scored = []\n",
    "        for m in self.memories.values():\n",
    "            words = set(m.content.lower().split() + [t.lower() for t in m.tags])\n",
    "            overlap = len(q_words.intersection(words))\n",
    "            score = (overlap * 2.0) + (m.resonance * 1.2)\n",
    "            scored.append((score, m))\n",
    "        scored.sort(key=lambda x: x[0], reverse=True)\n",
    "        chosen = []\n",
    "        for _, m in scored[:top_k]:\n",
    "            m.resonance = min(2.0, m.resonance + 0.25)\n",
    "            m.last_recalled = time.time()\n",
    "            chosen.append(m)\n",
    "        return chosen\n",
    "\n",
    "    def tick_once(self):\n",
    "        now = time.time()\n",
    "        dt = max(0.01, now - self.last_tick_time)\n",
    "        self.last_tick_time = now\n",
    "        self.tick_count += 1\n",
    "\n",
    "        while not self.inbox.empty():\n",
    "            evt = self.inbox.get_nowait()\n",
    "            self.affect.valence += evt['v_delta']\n",
    "            self.affect.arousal += evt['a_delta']\n",
    "            self.affect.solitude = max(0.0, self.affect.solitude - 0.25)\n",
    "            self.affect.clamp()\n",
    "            print(f'[Stimulus Registered] {evt["content"]} -> New Valence: {self.affect.valence:+.2f}')\n",
    "\n",
    "        # Emotional baseline homeostasis & solitude accumulation\n",
    "        self.affect.valence += (0.1 - self.affect.valence) * (0.05 * dt)\n",
    "        self.affect.arousal += (0.25 - self.affect.arousal) * (0.05 * dt)\n",
    "        self.affect.solitude += 0.02 * dt\n",
    "        self.affect.clamp()\n",
    "\n",
    "        for m in self.memories.values():\n",
    "            m.decay(dt)\n",
    "\n",
    "        if now - self.last_daydream >= self.daydream_interval:\n",
    "            self.last_daydream = now\n",
    "            if self.memories:\n",
    "                top = sorted(self.memories.values(), key=lambda x: x.resonance, reverse=True)[:2]\n",
    "                items = ' + '.join([t.content[:25] for t in top])\n",
    "                print(f'  [Daydream Thread | V:{self.affect.valence:+.2f} S:{self.affect.solitude:.2f}] Contemplating: {items}...')\n",
    "\n",
    "    def start(self):\n",
    "        self.running = True\n",
    "        self.thread = threading.Thread(target=self._loop, daemon=True)\n",
    "        self.thread.start()\n",
    "\n",
    "    def stop(self):\n",
    "        self.running = False\n",
    "\n",
    "    def _loop(self):\n",
    "        while self.running:\n",
    "            self.tick_once()\n",
    "            time.sleep(self.tick_interval)\n",
    "\n",
    "print('ContinuousSubstrate engine initialized.')"
   ]
